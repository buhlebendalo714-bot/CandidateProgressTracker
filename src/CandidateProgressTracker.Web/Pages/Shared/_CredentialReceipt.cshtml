@model CandidateProgressTracker.Application.Accounts.CredentialReceipt
@{ var recovery = Model.Kind == "Recovery"; var label = recovery ? "Password reset code" : "Activation code"; }
<section class="workspace-panel" role="status" aria-atomic="true" aria-label="@label">
<h2 class="h5">@label created</h2>
<p>For <strong>@Model.UserName</strong>. Share this code privately; it works once and is shown only on this page.</p>
<p><code>@Model.Credential</code></p>
<p>Expires @Model.ExpiresAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm") SAST.</p>
<p>Ask the account holder to open <a asp-page="/Account/CompleteCredential">Activate account or reset password</a> and choose their own password.</p>
<p>Previous codes no longer work. Existing sessions are signed out. Setting the password signs out any other sessions again.</p>
<details><summary>How to share the code safely</summary><p>Use a private channel. There is no automatic email. Never ask for the account holder's password. If the code is lost or expires, create a fresh code.</p></details>
</section>
