<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="navbar-text me-3">@User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <form method="post" asp-page="/Account/Logout" asp-area="">
                <button type="submit" class="nav-link btn btn-link text-dark">
                    Log out
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-page="/Account/Login" asp-area="">Log in</a>
        </li>
    }
</ul>