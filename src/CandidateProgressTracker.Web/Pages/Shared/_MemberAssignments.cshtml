@model CandidateProgressTracker.Application.Learning.MemberAssignmentPage

@if (Model.Assignments.Count == 0)
{
    <div class="alert alert-info">
        No assignments are available on this page.
    </div>
}
else
{
    @foreach (var assignment in Model.Assignments)
    {
        <section class="card mb-3">
            <div class="card-body">
                <h2 class="h5">@assignment.MilestoneTitle</h2>

                <p class="text-muted mb-2">
                    @assignment.CohortName / @assignment.CycleName /
                    @assignment.ProjectTitle
                </p>

                <dl class="row mb-2">
                    <dt class="col-sm-3">
                        @(assignment.IsTeamAssignment ? "Team" : "Candidate")
                    </dt>
                    <dd class="col-sm-9">@assignment.OwnerName</dd>

                    <dt class="col-sm-3">Deadline (SAST)</dt>
                    <dd class="col-sm-9">
                        @assignment.DueAt.ToOffset(TimeSpan.FromHours(2)).ToString("yyyy-MM-dd HH:mm")
                    </dd>

                    <dt class="col-sm-3">Required</dt>
                    <dd class="col-sm-9">
                        @(assignment.IsRequired ? "Yes" : "No")
                    </dd>
                </dl>

                <details>
                    <summary>
                        View assigned requirements — revision @assignment.RevisionNo
                    </summary>

                    <h3 class="h6 mt-3">Instructions</h3>
                    <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@assignment.Instructions</div>

                    <h3 class="h6 mt-3">Acceptance expectations</h3>
                    <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@assignment.AcceptanceExpectations</div>

                    <h3 class="h6 mt-3">Evidence requirements</h3>
                    <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@assignment.EvidencePolicy</div>
                </details>
            </div>
        </section>
    }
}

<nav aria-label="Assignment pages"
     class="d-flex align-items-center gap-3">
    @if (Model.PageNumber > 1)
    {
        <a asp-route-pageNumber="@(Model.PageNumber - 1)"
           class="btn btn-outline-secondary">
            Previous
        </a>
    }

    <span>Page @Model.PageNumber</span>

    @if (Model.HasNextPage)
    {
        <a asp-route-pageNumber="@(Model.PageNumber + 1)"
           class="btn btn-outline-secondary">
            Next
        </a>
    }
</nav>