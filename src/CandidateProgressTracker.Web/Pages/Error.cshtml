@page
@model ErrorModel
@{ ViewData["Title"] = "Unable to complete your request"; }
<div class="alert alert-danger" role="alert"><h1>Unable to complete your request</h1><p>Please try again. Before resubmitting, check whether your previous action was saved. If the problem continues, contact your support contact.</p></div>
@if(Model.ShowRequestId){<details><summary>Reference for support</summary><code>@Model.RequestId</code></details>}
<a asp-page="/Index">Return to your workspace</a>
