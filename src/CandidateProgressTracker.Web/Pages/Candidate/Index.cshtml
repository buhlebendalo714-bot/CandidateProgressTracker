@page
@model CandidateProgressTracker.Web.Pages.Candidate.IndexModel
@{
    ViewData["Title"] = "My cohorts";
}

<h1>My cohorts</h1>
<p>
    <a asp-page="./Assignments" class="btn btn-outline-primary">
        My assignments
    </a>
</p>

<p>Your current assignments in unarchived cohorts.</p>

@if (Model.Cohorts.Count == 0)
{
    <div class="alert alert-info" role="status">
        You have no current cohort assignments.
        Contact your administrator if you expected to see a cohort.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Code</th>
                    <th scope="col">Location</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cohort in Model.Cohorts)
                {
                    <tr>
                        <td>
                            <a asp-page="./Cycles" asp-route-id="@cohort.CohortId">
                                @cohort.Name
                            </a>
                        </td>
                        <td>@cohort.Code</td>
                        <td>@(cohort.LocationLabel ?? "Not specified")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}