@page
@model CandidateProgressTracker.Web.Pages.Admin.Users.CreateModel
<h1>Create account</h1>
@if(Model.Receipt is {} receipt){
    <partial name="_CredentialReceipt" model="receipt" />
    <a asp-page="./Index">Accounts</a>
}else{
<form class="workspace-panel management-form" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="Input.UserName">Username</label><input asp-for="Input.UserName" autocomplete="off" />
<label asp-for="Input.Email">Email</label><input asp-for="Input.Email" />
<label asp-for="Input.Role">Role</label><select asp-for="Input.Role"><option>Candidate</option><option>Mentor</option><option>Administrator</option></select>
<button type="submit">Create account and activation code</button>
</form>
}
