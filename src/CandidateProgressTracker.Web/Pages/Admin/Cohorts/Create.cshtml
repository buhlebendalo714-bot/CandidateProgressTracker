@page
@model CandidateProgressTracker.Web.Pages.Admin.Cohorts.CreateModel
@{
    ViewData["Title"] = "Create cohort";
}

<h1>Create cohort</h1>

<div class="row">
    <div class="col-md-6">
        <form class="workspace-panel management-form" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Code" class="form-label"></label>
                <input asp-for="Input.Code" class="form-control" />
                <div class="form-text">
                    Use a unique code, for example GQE-2026-01.
                    Codes are saved in uppercase.
                </div>
                <span asp-validation-for="Input.Code"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.LocationLabel"
                       class="form-label"></label>
                <input asp-for="Input.LocationLabel" class="form-control" />
                <span asp-validation-for="Input.LocationLabel"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create cohort
            </button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}