@page "{cycleId:guid}"
@model CandidateProgressTracker.Web.Pages.Admin.Projects.IndexModel
@{
    ViewData["Title"] = "Projects";
}

<h1>Projects</h1>

<p>
    Cohort: <strong>@Model.Cycle.CohortName</strong><br />
    Learning cycle: <strong>@Model.Cycle.CycleName</strong>
</p>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<div asp-validation-summary="All"
     class="text-danger"
     role="alert"></div>

@if (Model.Cycle.IsReadOnly)
{
    <div class="alert alert-info">
        This cycle or its cohort is archived. Projects are read-only.
    </div>
}
else
{
    <h2>Create project</h2>

    <form method="post"
          asp-route-cycleId="@Model.Cycle.CycleId"
          class="mb-4">
        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label"></label>
            <input asp-for="Input.Title"
                   class="form-control"
                   maxlength="200" />
            <span asp-validation-for="Input.Title"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Brief" class="form-label"></label>
            <textarea asp-for="Input.Brief"
                      class="form-control"
                      rows="6"
                      maxlength="10000"></textarea>
            <span asp-validation-for="Input.Brief"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Mode" class="form-label"></label>
            <select asp-for="Input.Mode" class="form-select">
                <option value="">Select a mode</option>
                <option value="1">Individual</option>
                <option value="2">Team</option>
            </select>
            <span asp-validation-for="Input.Mode"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create project
        </button>
    </form>
}

<h2>Existing projects</h2>

@if (Model.Cycle.Projects.Count == 0)
{
    <p>No projects have been created for this learning cycle.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Mode</th>
                    <th scope="col">Archive status</th>
                    <th scope="col">Brief</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Cycle.Projects)
                {
                    <tr>
                        <td>@project.Title</td>
                        <td>@project.Mode</td>
                        <td>@(project.IsArchived ? "Archived" : "Not archived")</td>
                        <td>
                            <details>
                                <summary>View brief</summary>
                                <div style="white-space: pre-wrap; overflow-wrap: anywhere;">@project.Brief</div>
                            </details>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-page="/Admin/Cohorts/Cycles"
   asp-route-id="@Model.Cycle.CohortId"
   class="btn btn-secondary">
    Back to learning cycles
</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}