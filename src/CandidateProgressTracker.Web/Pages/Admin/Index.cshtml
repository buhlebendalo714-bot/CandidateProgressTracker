@page
@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
@model CandidateProgressTracker.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Administration";
}

<h1>Administration</h1>
<p>You are signed in with administrator access.</p>

<a asp-page="/Admin/Users/Index" class="btn btn-primary">
    Manage user accounts
</a>

<a asp-page="/Admin/Cohorts/Index" class="btn btn-outline-primary">
    Manage cohorts
</a>