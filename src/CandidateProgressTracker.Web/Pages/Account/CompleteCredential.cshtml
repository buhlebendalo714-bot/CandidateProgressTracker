@page
@model CandidateProgressTracker.Web.Pages.Account.CompleteCredentialModel
<h1>Activate account or reset password</h1>
@if(Model.Completed){<p role="status" aria-atomic="true">Password saved. You can now log in with your new password. Previous codes no longer work and other sessions are signed out.</p><a asp-page="./Login">Log in</a>}
else{
<p>Ask your administrator for an activation code or password reset code. Never share your password.</p>
<form class="management-form" method="post">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="UserName">Username</label><input asp-for="UserName" autocomplete="username" /><span asp-validation-for="UserName" class="text-danger"></span>
<label asp-for="Credential">Activation or password reset code</label><input asp-for="Credential" type="password" autocomplete="off" /><span asp-validation-for="Credential" class="text-danger"></span>
<label asp-for="Password">New password (12–128 characters)</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span>
<label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span>
<button type="submit">Set password</button>
</form>
}
